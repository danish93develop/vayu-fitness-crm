# ─────────────────────────────────────────────────────────────
# Database (matches docker-compose.yml defaults)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://vayu:vayu_dev_password@localhost:5432/vayu_fitness_crm?schema=public"

# ─────────────────────────────────────────────────────────────
# Auth.js / NextAuth
# Generate a strong secret with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
AUTH_SECRET="replace-with-32-byte-base64-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ─────────────────────────────────────────────────────────────
# Default admin (used by seed script — change before deploying!)
# ─────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-before-deploy"
SEED_ADMIN_NAME="Admin"

# ─────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="debug"
